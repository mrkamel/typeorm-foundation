{
  "name": "typeorm-foundation",
  "version": "0.8.0",
  "description": "Base repository and entity validation building blocks for TypeORM.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
